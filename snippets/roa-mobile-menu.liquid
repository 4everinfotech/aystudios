<div class="roa-mobile-menu">

  <!-- SEARCH -->
  <div class="roa-search">
    <input type="text" placeholder="SEARCH..." />
  </div>

  <!-- MENU -->
  <ul class="roa-menu-list">

    {% for link in linklists.roa-menu.links %}

      {% if link.links != blank %}
        
        <!-- PARENT WITH CHILD -->
        <li class="has-submenu">
          <div class="submenu-toggle">
            <span>{{ link.title }}</span>
          </div>

          <ul class="submenu">
            {% for child in link.links %}
              <li>
                <a href="{{ child.url }}">{{ child.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </li>

      {% else %}

        <!-- SIMPLE LINK -->
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
        </li>

      {% endif %}

    {% endfor %}

  </ul>

  <!-- FOOTER -->
  <div class="roa-footer-text">
    Follow The Sun
  </div>

</div>